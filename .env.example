# Local dev defaults — copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/b3
ENGINE_DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/b3
SECRET_KEY=dev-secret-change-me
UPLOADS_DIR=./uploads
# taxcore location — leave UNSET on the host (defaults to ../taxcore + its .venv).
# The image sets TAXCORE_DIR=/opt/taxcore and TAXCORE_PYTHON there; do NOT set them
# here (this file is the containers' env_file and an empty value would override the image).
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Google OAuth — leave empty locally; dev login route is enabled when ENVIRONMENT=development
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Stripe — test mode. The price ids are public identifiers and live here so
# `docker compose up` can sell without extra setup; the keys are secrets and belong
# in .env (gitignored), which compose interpolates into the api container.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price per module (STRIPE_PRICE_<id>, matching billing.SELLABLE; carteira is free, so it has no price).
# A módulo without a price is refused at checkout with a 400, which is the honest
# failure: no test prices are created for these yet.
STRIPE_PRICE_IRPF=
STRIPE_PRICE_MERCADO=
STRIPE_PRICE_INDICE=
STRIPE_PRICE_BENCH=
STRIPE_PRICE_EMPRESARIAL=

# SEC EDGAR requires a declaring User-Agent on every request. The client
# defaults to one naming this project, so ingestion works unconfigured; set a
# contact of your own here when running against your own domain.
SEC_USER_AGENT=
