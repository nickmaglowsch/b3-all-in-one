# Template for the VPS's .env.prod (gitignored, lives only at ~/b3-all-in-one/.env.prod).
# Consumed by `docker compose --env-file .env.prod -f docker-compose.prod.yml`.

# Database on the shared infra_postgres container (~/infra/docker-compose.yml).
POSTGRES_DB=b3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
SECRET_KEY=change-me

# Cloudflare Pages URL. ALLOWED_ORIGINS is the CORS list (comma-separated).
FRONTEND_URL=https://b3-all-in-one.pages.dev
ALLOWED_ORIGINS=https://b3-all-in-one.pages.dev

# Google OAuth (Google Cloud Console → Credentials → OAuth client, "Web application").
# Authorized redirect URI (exact): https://b3-api.duckdns.org/auth/google/callback
# On success the API 302s to $FRONTEND_URL/auth/callback?token=<jwt>.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe live/test keys. Webhook endpoint: https://b3-api.duckdns.org/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price per module (STRIPE_PRICE_<id>, matching billing.SELLABLE; carteira is free, so it has no price).
STRIPE_PRICE_IRPF=
STRIPE_PRICE_MERCADO=
STRIPE_PRICE_INDICE=
STRIPE_PRICE_BENCH=
STRIPE_PRICE_EMPRESARIAL=

# SEC EDGAR requires a declaring User-Agent. Optional — the client defaults to
# one naming the project — but set your own contact when running in production,
# so a SEC administrator has someone to reach.
SEC_USER_AGENT=Quantax ingest contato@seudominio.com.br
# Alpha Vantage serves the US price and listing feeds. A free key is issued at
# alphavantage.co/support/#api-key and allows 25 requests a day, which is enough
# for the listing universe (two calls) and makes the price backfill a slow trickle.
# A paid key changes no code: set the two tuning variables below.
ALPHAVANTAGE_API_KEY=
# Free tier: 5/min and a hard 25/day. Paid: 75 (or higher) and 0 for no daily cap.
ALPHAVANTAGE_RATE_PER_MIN=
ALPHAVANTAGE_DAILY_BUDGET=
# Nasdaq Data Link keys the WIKI bulk backfill: 56 years of US history in one
# request. A free key is issued at data.nasdaq.com/sign-up. Without it
# `ingest_wiki_backfill` refuses rather than running empty. The dataset was
# frozen in April 2018, so this is history, not a feed — `ingest_us_backfill`
# is what reaches the present, and it needs no key at all.
NASDAQ_DATA_LINK_API_KEY=
# Seconds between requests in the US backfill's walk of the free quote endpoint.
# Politeness, not correctness: it is a small host serving a whole market one
# symbol at a time for nothing. Default 0.5.
STOOQ_DELAY_SECONDS=

# Massive (formerly Polygon.io). Free key from https://massive.com —
# grouped daily bars and the split feed for the US daily refresh.
MASSIVE_API_KEY=
