# Template for the VPS's .env.prod (gitignored, lives only at ~/b3-all-in-one/.env.prod).
# Consumed by `docker compose --env-file .env.prod -f docker-compose.prod.yml`.

# Database on the shared infra_postgres container (~/infra/docker-compose.yml).
POSTGRES_DB=b3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
SECRET_KEY=change-me

# Cloudflare Pages URL. ALLOWED_ORIGINS is the CORS list (comma-separated).
FRONTEND_URL=https://b3-all-in-one.pages.dev
ALLOWED_ORIGINS=https://b3-all-in-one.pages.dev

# Google OAuth (Google Cloud Console → Credentials → OAuth client, "Web application").
# Authorized redirect URI (exact): https://b3-api.duckdns.org/auth/google/callback
# The SPA starts the flow by navigating to https://b3-api.duckdns.org/auth/google/login.
# On success the API 302s to $FRONTEND_URL/auth/callback#token=<jwt> (fragment, never
# the query string); on failure to $FRONTEND_URL/login?erro=<code>.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe live/test keys. Webhook endpoint: https://b3-api.duckdns.org/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price per module (STRIPE_PRICE_<id>, matching billing.SELLABLE; carteira is free, so it has no price).
STRIPE_PRICE_IRPF=
STRIPE_PRICE_MERCADO=
STRIPE_PRICE_INDICE=
STRIPE_PRICE_BENCH=
STRIPE_PRICE_EMPRESARIAL=

# SEC EDGAR requires a declaring User-Agent. Optional — the client defaults to
# one naming the project — but set your own contact when running in production,
# so a SEC administrator has someone to reach.
SEC_USER_AGENT=Quantax ingest contato@seudominio.com.br
# Alpha Vantage serves the US price and listing feeds. A free key is issued at
# alphavantage.co/support/#api-key and allows 25 requests a day, which is enough
# for the listing universe (two calls) and makes the price backfill a slow trickle.
# A paid key changes no code: set the two tuning variables below.
ALPHAVANTAGE_API_KEY=
# Free tier: 5/min and a hard 25/day. Paid: 75 (or higher) and 0 for no daily cap.
ALPHAVANTAGE_RATE_PER_MIN=
ALPHAVANTAGE_DAILY_BUDGET=
# Nasdaq Data Link keys the WIKI bulk backfill: 56 years of US history in one
# request. A free key is issued at data.nasdaq.com/sign-up. Without it
# `ingest_wiki_backfill` refuses rather than running empty. The dataset was
# frozen in April 2018, so this is history, not a feed — `ingest_us_daily`
# is what reaches the present.
NASDAQ_DATA_LINK_API_KEY=

# Massive (formerly Polygon.io). Free key from https://massive.com —
# grouped daily bars and the split feed for the US daily refresh.
MASSIVE_API_KEY=
# Seconds between Massive requests. Unset: 13 (the free tier's 5/min).
# MASSIVE_DELAY_SECONDS=

# ── Container ceilings ────────────────────────────────────────────────────────
# The api, worker and ingest containers share this VPS with infra_postgres,
# infra_caddy and every other app on it. Uncapped, one backtest could push the
# box into swap and stall every request on it — see the comments in
# docker-compose.prod.yml. These are the defaults compose applies when unset;
# set them here to fit a smaller box.
#
# Sizing: one engine subprocess peaks around 1.3 GB on B3 and is single-threaded.
# The worker runs two at once, the api one per portfolio sleeve. Below ~2g a
# normal backtest is killed rather than bounded, which trades one failure mode
# for another — so lower these deliberately, and watch for runs failing with
# "killed by SIGKILL".
#
# A US or crypto window is a bigger frame than a B3 one — an order of magnitude
# more names — so these ceilings are what a long US backtest runs into first.
# Every run now reports `peak_rss_mb` in its metrics: size from that rather than
# from this comment. The engine caps its own heap at 80% of whatever ceiling it
# finds, which turns an overrun into a stated error instead of a bare SIGKILL;
# ENGINE_BACKTEST_MEM_MB overrides that cap (0 disables it).
API_MEM_LIMIT=3g
API_CPUS=2
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2
INGEST_MEM_LIMIT=4g
INGEST_CPUS=2
# The engine's own guard, on api and worker. Unset: 80% of the container ceiling.
# ENGINE_BACKTEST_MEM_MB=
# ENGINE_BACKTEST_MEM_FRACTION=
# Names per market-panel scan; ENGINE_MEM_TRACE=1 prints peak RSS per stage.
# ENGINE_PANEL_BATCH=
# ENGINE_MEM_TRACE=

# ── Timeouts and the ingest schedule ─────────────────────────────────────────
# Unset, each takes config.py's default (docker-compose.prod.yml repeats them).
# Cron is UTC. Uncomment only what you mean to change.
# SUBPROCESS_TIMEOUT_S=600
# INGEST_TIMEOUT_S=21600
# INGEST_START_YEAR=2005
# INGEST_PRICES_CRON=0 6 * * *
# INGEST_FUNDAMENTALS_CRON=0 7 * * 0
# INGEST_INSTRUMENTS_CRON=0 9 * * *
# INGEST_CRYPTO_CRON=0 4 * * *
# INGEST_US_FUNDAMENTALS_CRON=0 8 * * 0
# INGEST_US_SYMBOLS_CRON=0 23 * * 1-5
# INGEST_US_LISTING_CRON=0 22 * * 1-5
# INGEST_US_DAILY_CRON=0 7 * * *
# INGEST_US_PRICES_CRON=0 5 * * *
# INGEST_SPX_CRON=30 5 * * 1-5
