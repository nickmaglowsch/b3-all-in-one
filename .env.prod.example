# Template for the VPS's .env.prod (gitignored, lives only at ~/b3-all-in-one/.env.prod).
# Consumed by `docker compose --env-file .env.prod -f docker-compose.prod.yml`.

# Database on the shared infra_postgres container (~/infra/docker-compose.yml).
POSTGRES_DB=b3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
SECRET_KEY=change-me

# Cloudflare Pages URL. ALLOWED_ORIGINS is the CORS list (comma-separated).
FRONTEND_URL=https://b3-all-in-one.pages.dev
ALLOWED_ORIGINS=https://b3-all-in-one.pages.dev

# Google OAuth (Google Cloud Console → Credentials → OAuth client, "Web application").
# Authorized redirect URI (exact): https://b3-api.duckdns.org/auth/google/callback
# On success the API 302s to $FRONTEND_URL/auth/callback?token=<jwt>.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe live/test keys. Webhook endpoint: https://b3-api.duckdns.org/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INVESTIDOR=
STRIPE_PRICE_TRADER=
