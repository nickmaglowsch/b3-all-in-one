__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# mutmut 3 copies the tree it mutates into ./mutants
mutants/
.mutmut-cache
build/
dist/
target/
*.sqlite
*.log
.env
.env.prod
.env.local
# Every backup of one, too. A copy named `.env.prod.bak-20260902-154223` sat
# untracked and unignored in the VPS checkout for a day: the deploy does
# `git reset --hard`, which leaves an untracked file alone, so it survives
# indefinitely one `git add -A` away from being committed. The glob, not the
# one name, because the next one will be stamped with a different date.
.env*.bak*
node_modules/
.next/
.open-next/
out/
data/raw/
engine/b3_market_data.sqlite
.DS_Store

# Runtime upload/artifact storage (UPLOADS_DIR defaults to ./uploads at repo root,
# so platform/.gitignore never matched it — that is how real B3 extracts got committed).
uploads/
artifacts/

# Generated reports hold real portfolio figures. Keep the dir, never the contents.
taxcore/reports/*
!taxcore/reports/.gitkeep

# Agent scratch output. Both are append-only logs of a tool's runs against this
# tree — three of the five committed critiques were the same file at three
# timestamps. git history already records what changed and why; these only
# record what a tool said on the way there. The live config stays tracked.
.impeccable/critique/
.claude/agent-memory/
# An agent's working notes across a context window — same reason as above.
.claude/handoff.md
