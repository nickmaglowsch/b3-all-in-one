# Build context is the repo root. Patterns are relative to the context root.
# BuildKit uses this file (adjacent to the Dockerfile) in preference to a root
# .dockerignore. Everything is excluded, then only what the image needs is added back.
*

# platform app
!platform
platform/.venv
platform/**/__pycache__
platform/.pytest_cache
platform/.ruff_cache
platform/uploads

# taxcore: bake in ONLY the code + dep manifests. b3_imports/, data/, reports/,
# tests/ hold REAL personal financial data — they must NEVER enter the image.
!taxcore
taxcore/*
!taxcore/scripts
!taxcore/pyproject.toml
!taxcore/uv.lock
taxcore/**/__pycache__

# engine: bake in ONLY the backtest CODE + requirements. NO tests, NO data/db/.venv
# — backtests read the market plane from Postgres, not from files in the image.
!engine
engine/*
!engine/b3_pipeline
!engine/backtests
!engine/crypto_pipeline
!engine/scripts
!engine/requirements-bench.txt
engine/b3_pipeline/**/__pycache__
engine/backtests/**/__pycache__
engine/crypto_pipeline/**/__pycache__
engine/scripts/**/__pycache__
engine/backtests/output
